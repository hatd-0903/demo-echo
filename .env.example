# Sao chép thành .env rồi điền giá trị: cp .env.example .env
# Biến môi trường thật (Docker, CI, shell) luôn được ưu tiên hơn file này.
# Đổi file khác bằng ENV_FILE, vd: ENV_FILE=.env.staging make run

# ---- App ----
# development | production (production bắt buộc JWT_SECRET >= 32 ký tự, SQL log ít hơn)
APP_ENV=development
APP_PORT=8080

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=secret
DB_NAME=demo_echo

# ---- JWT ----
# Tạo secret: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=72h

# ---- Redis cache ----
# Để trống REDIS_URL để tắt cache. Dạng: redis://[:password@]host:port/db
REDIS_URL=redis://127.0.0.1:6379/0
# Thời gian sống của cache (vd. 30s, 5m, 1h)
CACHE_TTL=5m

# ---- Swagger ----
# Swagger UI tại /swagger/index.html. Mặc định: bật ở development, tắt ở production.
# SWAGGER_ENABLED=true
